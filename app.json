{
  "expo": {
    "name": "ApunteIA",
    "slug": "apunteia",
    "scheme": "apunteia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "gt.edu.apunteia",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      "expo-image-picker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
